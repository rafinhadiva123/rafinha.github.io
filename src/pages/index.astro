---
/* Home provisória enquanto o jardim está pausado (ele está guardado em
   /jardim-pausado/). Só uma monarca atravessando a tela, sem texto nem links.
   A borboleta (textura, geometria e batida de asas) é copiada de
   src/components/jardim/cena.js. */
---

<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>rafinha.xyz</title>
<meta name="theme-color" content="#1b2a1f">
<meta name="generator" content={Astro.generator}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<style>
  html, body { height: 100%; margin: 0; overflow: hidden; }
  html { background: #1b2a1f; }
  body { background: radial-gradient(120% 80% at 50% 0%, #26402b 0%, #1b2a1f 60%); background-color: #1b2a1f; }
  #voo { position: fixed; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
</style>
</head>
<body>
<canvas id="voo" aria-hidden="true"></canvas>
<script>
  import * as THREE from 'three'

  const canvas = document.getElementById('voo') as HTMLCanvasElement
  const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches

  if (document.createElement('canvas').getContext('webgl')) iniciar()

  function iniciar() {
    /* ---------- utilidades (iguais às do jardim) ---------- */
    function clamp(v: number, a: number, b: number) { return Math.max(a, Math.min(b, v)) }
    function smooth(a: number, b: number, v: number) { const t = clamp((v - a) / (b - a), 0, 1); return t * t * (3 - 2 * t) }
    function col(hex: number) { return new THREE.Color(hex).convertSRGBToLinear() }
    function mat(hex: number, o?: object) { return new THREE.MeshStandardMaterial(Object.assign({ color: col(hex), roughness: .9, metalness: 0 }, o || {})) }
    function srgb(t: THREE.Texture) { t.encoding = THREE.sRGBEncoding; t.anisotropy = 4; return t }

    /* ---------- renderer, cena, câmera, luzes ---------- */
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true })
    renderer.setClearColor(0x000000, 0)
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
    renderer.outputEncoding = THREE.sRGBEncoding
    renderer.toneMapping = THREE.ACESFilmicToneMapping
    renderer.toneMappingExposure = .9
    const scene = new THREE.Scene()
    const camera = new THREE.PerspectiveCamera(48, 1, .1, 100)
    camera.position.set(0, 9, 4.5)
    camera.lookAt(0, 0, 0)
    camera.updateMatrixWorld()
    const sun = new THREE.DirectionalLight(col(0xffd39a), 3.1)
    sun.position.set(-3, 8, -2)
    scene.add(sun)
    scene.add(new THREE.HemisphereLight(col(0xa9c4e6), col(0x4d5a2a), .55))

    /* ---------- borboleta (copiada de components/jardim/cena.js) ---------- */
    function wingTexture(kind: string) {
      var c = document.createElement('canvas'); c.width = 256; c.height = 200; var g = c.getContext('2d')!;
      var P = ({
        monarch:  { a: '#f08a1c', b: '#d6560e', edge: '#1b120c', dots: '#fff6e0', vein: '#1b120c' }
      } as Record<string, { a: string, b: string, edge: string, dots: string, vein: string }>)[kind];
      function fore() { g.beginPath(); g.moveTo(3, 96); g.bezierCurveTo(24, 8, 130, -6, 252, 28); g.bezierCurveTo(248, 60, 200, 96, 120, 100); g.lineTo(3, 106); g.closePath(); }
      function hind() { g.beginPath(); g.moveTo(3, 104); g.bezierCurveTo(70, 100, 160, 100, 196, 140); g.bezierCurveTo(200, 190, 110, 204, 60, 176); g.bezierCurveTo(30, 154, 6, 130, 3, 118); g.closePath(); }
      [fore, hind].forEach(function (fn, wi) {
        g.save(); fn(); g.clip();
        var gr = g.createLinearGradient(0, 0, 250, 0); gr.addColorStop(0, P.b); gr.addColorStop(.6, P.a); gr.addColorStop(1, P.a); g.fillStyle = gr; g.fillRect(0, 0, 256, 220);
        g.strokeStyle = P.vein; g.lineWidth = 2.2; for (var i = 0; i < 8; i++) { g.beginPath(); g.moveTo(4, 102); g.quadraticCurveTo(80, wi ? 120 + i * 9 : 88 - i * 8, 250, wi ? 110 + i * 12 : 4 + i * 16); g.stroke(); }
        g.lineWidth = 16; g.strokeStyle = P.edge; fn(); g.stroke();
        g.fillStyle = P.dots; for (var d2 = 0; d2 < 9; d2++) { var t2 = d2 / 8; g.beginPath(); if (wi === 0) g.arc(60 + t2 * 180, 22 + t2 * 44 + Math.sin(t2 * 3) * 4, 3.4, 0, 6.28); else g.arc(30 + t2 * 140, 176 - Math.sin(t2 * 2) * 12 - t2 * 20, 3.2, 0, 6.28); g.fill(); }
        g.restore();
      });
      return srgb(new THREE.CanvasTexture(c));
    }
    var wingTex: Record<string, THREE.Texture> = { monarch: wingTexture('monarch') };
    var wingGeoCache: Record<string, THREE.PlaneGeometry> = {};
    function wingGeo(w: number, h: number) { var k = w + 'x' + h; if (!wingGeoCache[k]) { var g = new THREE.PlaneGeometry(w, h); g.rotateX(Math.PI / 2); g.translate(w / 2, 0, 0); wingGeoCache[k] = g; } return wingGeoCache[k]; }
    var bodyMat = mat(0x1a1410, { roughness: .8 });
    function makeButterfly(kind: string, size: number) {
      var g = new THREE.Group(), tex = wingTex[kind];
      var wm = new THREE.MeshStandardMaterial({ map: tex, alphaTest: .35, side: THREE.DoubleSide, roughness: .75, emissive: 0xffffff, emissiveMap: tex, emissiveIntensity: kind === 'white' ? .32 : .16, envMapIntensity: .5 });
      var wg = wingGeo(1, .8), R = new THREE.Group(), Lf = new THREE.Group(), Lin = new THREE.Group();
      var rw = new THREE.Mesh(wg, wm), lw = new THREE.Mesh(wg, wm); R.add(rw); Lin.add(lw); Lf.add(Lin); Lf.scale.x = -1;
      var body = new THREE.Mesh(new THREE.CylinderGeometry(.035, .028, .7, 6), bodyMat); body.rotation.x = Math.PI / 2; body.scale.set(1, 1, 1);
      var head = new THREE.Mesh(new THREE.SphereGeometry(.05, 8, 6), bodyMat); head.position.z = .38;
      var ant = new THREE.Mesh(new THREE.CylinderGeometry(.006, .006, .3, 3), bodyMat); ant.position.set(.05, .05, .5); ant.rotation.set(1.1, 0, -.4);
      var ant2 = ant.clone(); ant2.position.x = -.05; ant2.rotation.z = .4;
      var inner = new THREE.Group(); inner.add(R, Lf, body, head, ant, ant2); inner.scale.setScalar(size); g.add(inner);
      g.userData = { R: R, Lin: Lin, inner: inner, flap: 0 };
      return g;
    }

    /* ---------- a monarca ---------- */
    // a geometria tem 1 de envergadura por asa, então `size` = metade da envergadura
    const bf = makeButterfly('monarch', 1)
    scene.add(bf)
    const inner = bf.userData.inner as THREE.Group
    const R = bf.userData.R as THREE.Group, Lin = bf.userData.Lin as THREE.Group
    const flapHz = 10.5, ph = 1.7

    // ponto do plano y=0 que aparece na coordenada de tela (nx, ny) em [-1, 1]
    function noChao(nx: number, ny: number) {
      const v = new THREE.Vector3(nx, ny, .5).unproject(camera).sub(camera.position)
      return camera.position.clone().addScaledVector(v, -camera.position.y / v.y)
    }

    const VOO = 9, PAUSA = 2.5
    let ini = new THREE.Vector3(), fim = new THREE.Vector3(), lado = new THREE.Vector3(), amp = 1, rumo = 0
    function resize() {
      const w = innerWidth, h = innerHeight
      renderer.setSize(w, h, false)
      camera.aspect = w / h; camera.updateProjectionMatrix()
      // envergadura ≈ 20% da menor dimensão da tela, medida no centro da cena
      const a = noChao(-1, 0), b = noChao(1, 0), porPx = a.distanceTo(b) / w
      const envergadura = .2 * Math.min(w, h) * porPx
      inner.scale.setScalar(envergadura / 2)
      // do canto inferior esquerdo ao superior direito, com folga para entrar e sair inteira
      const c0 = noChao(-1, -1), c1 = noChao(1, 1), dir = c1.clone().sub(c0).normalize()
      const folga = envergadura * 1.1
      ini = c0.addScaledVector(dir, -folga); fim = c1.addScaledVector(dir, folga)
      lado.set(-dir.z, 0, dir.x)
      amp = ini.distanceTo(fim) * .06
      rumo = Math.atan2(dir.x, dir.z)
      if (reduce) parada()
    }

    // asas abertas, parada no meio da tela, apontando para o canto superior direito
    function parada() {
      bf.position.set(0, 0, 0); bf.rotation.set(0, rumo, 0, 'YXZ')
      R.rotation.z = .35; Lin.rotation.z = .35
      renderer.render(scene, camera)
    }

    addEventListener('resize', resize)
    resize()
    if (reduce) return

    const clock = new THREE.Clock(), prev = new THREE.Vector3(), pos = new THREE.Vector3()
    let yaw = rumo, primeiro = true
    renderer.setAnimationLoop(() => {
      const dt = Math.min(clock.getDelta(), .05), t = clock.elapsedTime
      const ciclo = t % (VOO + PAUSA)
      if (ciclo > VOO) { bf.visible = false; primeiro = true; renderer.render(scene, camera); return }
      bf.visible = true
      const u = ciclo / VOO
      // reta entre os cantos + ondulação lateral e um leve sobe e desce
      pos.lerpVectors(ini, fim, u)
        .addScaledVector(lado, amp * Math.sin(u * Math.PI * 3.2) * Math.sin(u * Math.PI))
      pos.y = .25 * Math.sin(t * 2.3) + .08 * Math.sin(t * 5.1)
      if (primeiro) { prev.copy(pos); yaw = rumo; primeiro = false }
      const vx = pos.x - prev.x, vz = pos.z - prev.z, vy = pos.y - prev.y
      if (vx * vx + vz * vz > 1e-8) { const ty = Math.atan2(vx, vz); let dy = ty - yaw; dy = Math.atan2(Math.sin(dy), Math.cos(dy)); yaw += dy * (1 - Math.exp(-dt * 5)) }
      prev.copy(pos)
      // orientação e batida de asas, como no jardim
      bf.position.copy(pos)
      bf.rotation.set(-clamp(vy / Math.max(dt, .001) * .25, -.5, .5), yaw, Math.sin(t * 2 + ph) * .12, 'YXZ')
      const burst = .5 + .5 * Math.sin(t * 1.6 + ph), forca = .35 + .65 * smooth(.15, .5, burst), fl = Math.sin(t * flapHz + ph)
      const ang = .12 + (fl * .5 + .5) * (.7 + .5 * forca) * 1.05
      R.rotation.z = ang; Lin.rotation.z = ang
      renderer.render(scene, camera)
    })
  }
</script>
</body>
</html>
