---
import Base from '../layouts/Base.astro'
import Jardim from '../components/Jardim.astro'
import { getCollection } from 'astro:content'

const todos = await getCollection('experimentos')
const experimentos = todos
  .filter((experimento) => !import.meta.env.PROD || experimento.data.status === 'publicado')
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
---

<Base titulo="rafinha.xyz">
  <h1>rafinha.xyz</h1>
  <p class="leitura">
    Laboratório pessoal de experimentos interativos — coisas pequenas, feitas pra
    aprender e brincar. Cada borboleta com nome é um experimento; clique numa pra
    entrar, ou clique no jardim pra soltar mais.
  </p>

  <Jardim experimentos={experimentos} />
</Base>
