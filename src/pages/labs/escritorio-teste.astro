---
// Página de teste do Simulador de escritório (Bloco 4, item 5). Não aparece em
// menus nem no sitemap, e não é indexada. Usa o banco do Supabase; com ?local
// usa o banco deste navegador, sem rede.
import Base from '../../layouts/Base.astro'
---

<Base titulo="Escritório · teste" noindex>
  <section class="teste">
    <h1>Escritório · teste</h1>
    <p class="teste-sub">Página de teste, sem link no site. Clique no + de uma cadeira livre para sentar.</p>
    <div id="palco" class="teste-palco"></div>
  </section>
</Base>

<style>
  .teste { margin-block: 1.5rem; }
  .teste h1 { margin: 0 0 0.25rem; font-size: 1.5rem; }
  .teste-sub { margin: 0 0 1rem; opacity: 0.8; font-size: 0.9rem; }
</style>

<script>
  import { criarEscritorio } from '../../components/labs/escritorio/ui/escritorio.js'
  import { criarBancoSupabase, criarBancoLocal } from '../../components/labs/escritorio/dados/banco.js'
  import { SUPABASE } from '../../components/labs/escritorio/dados/config.js'

  const palco = document.getElementById('palco')
  if (palco) {
    const local = new URLSearchParams(location.search).has('local')
    let banco = null
    try {
      banco = local ? criarBancoLocal() : criarBancoSupabase(SUPABASE)
    } catch {
      /* sem banco a planta ainda aparece, com os fixos e um aviso */
      banco = null
    }
    criarEscritorio(palco, banco)
  }
</script>
