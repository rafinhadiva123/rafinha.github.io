---
/**
 * Que palmeira é você? Teste de personalidade com 10 perguntas e 10 palmeiras.
 * Mesmo esquema do Ateliê de Notas: o jogo redesenha o painel com innerHTML,
 * num <script> que o Astro empacota só pra esta página. Fotos em
 * public/labs/palmeira; se uma falhar, aparece a ilustração em SVG.
 */
import '@fontsource/bodoni-moda/500.css'
import '@fontsource/bodoni-moda/500-italic.css'
import '@fontsource/figtree/400.css'
import '@fontsource/figtree/500.css'
import '@fontsource/figtree/600.css'
---

<div class="palmeira" id="palmeira">
  <div class="scene" aria-hidden="true"></div>
  <div class="wrap">
    <div data-app aria-live="polite"></div>
    <p class="foot">Um teste de brincadeira: as descrições juntam traços reais de cada espécie (clima, crescimento, formato) com personalidade. Não é ciência, é jardim.</p>
  </div>
</div>

<script>
  import { iniciar } from './jogo.js'

  const raiz = document.getElementById('palmeira')
  if (raiz) iniciar(raiz)
</script>

<!-- global porque o painel é criado pelo script; tudo fica preso em .palmeira. -->
<style is:global>
  .palmeira {
    --bg: #fbf3dc;
    --surface: #fffdf6;
    --surface-2: #f7efd6;
    --line: rgba(58, 74, 12, 0.3);
    --fg: #1e2808;
    --muted: #39461a;
    --accent: #3f5a12;
    --on-accent: #fff;
    --c: var(--accent);
    --display: 'Bodoni Moda', 'Didot', 'Times New Roman', serif;
    --body: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color-scheme: light;
    margin-block: 1.5rem;
    color: var(--fg);
    font-family: var(--body);
    font-size: 16px;
    line-height: 1.5;
  }

  /* As listras ocupam a página inteira: os tokens do site viram os do teste
     (nos dois temas), então cabeçalho, título e rodapé ficam legíveis. */
  html:has(.palmeira) {
    --fundo: #fbf3dc;
    --superficie: #fffdf6;
    --texto: #1e2808;
    --texto-suave: #39461a;
    --borda: rgba(58, 74, 12, 0.3);
    --destaque: #3f5a12;
    color-scheme: light;
  }

  html:has(.palmeira) body {
    background: transparent;
  }

  html:has(.palmeira) :is(.experimento__cabecalho, body > header, body > footer) {
    text-shadow: 0 0 10px rgba(251, 243, 220, 0.95), 0 0 3px rgba(251, 243, 220, 0.9);
  }

  .palmeira *,
  .palmeira *::before,
  .palmeira *::after {
    box-sizing: border-box;
  }

  .palmeira [hidden] {
    display: none !important;
  }

  .palmeira :is(h1, h2):focus {
    outline: none;
  }

  .palmeira .scene { position:fixed;inset:0;z-index:-1;overflow:hidden;background:repeating-linear-gradient(90deg,#aab533 0 10px,#fbf3dc 10px 21px) }
  .palmeira .wrap { position:relative;max-width:980px;margin:0 auto;display:flex;flex-direction:column;gap:28px;background:#fbf3dc;border:1px solid var(--line);border-radius:18px;padding:30px 30px 24px;box-shadow:0 10px 34px rgba(48,62,8,.22) }
  @media(max-width:600px) {
    .palmeira .wrap { padding:20px 16px 18px;border-radius:14px;gap:22px }
  }
  .palmeira .eyebrow, .palmeira .lede, .palmeira .hint, .palmeira .foot, .palmeira h1, .palmeira h2, .palmeira .step, .palmeira .legend { text-shadow:0 0 10px rgba(251,243,220,.95),0 0 3px rgba(251,243,220,.9) }
  .palmeira .eyebrow { font-weight:600;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted) }
  .palmeira h1, .palmeira h2, .palmeira h3 { font-family:var(--display);font-style:italic;font-weight:500;margin:0;text-wrap:balance }
  .palmeira h1 { font-size:clamp(40px,8vw,72px);line-height:1 }
  .palmeira h2 { font-size:clamp(26px,4.6vw,38px);line-height:1.12 }
  .palmeira .lede { font-weight:500;color:var(--muted);max-width:54ch;margin:0;line-height:1.6 }
  .palmeira .screen { display:flex;flex-direction:column;gap:22px;animation:palmeira-rise .35s ease both }
  @keyframes palmeira-rise {from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .palmeira .btn { font:inherit;font-weight:600;color:var(--on-accent);background:var(--accent);border:0;border-radius:999px;padding:13px 26px;cursor:pointer;align-self:flex-start;transition:transform .15s,filter .15s }
  .palmeira .btn:hover { transform:translateY(-1px);filter:brightness(1.1) }
  .palmeira .btn.ghost { background:var(--surface);color:var(--accent);border:1px solid var(--accent) }
  .palmeira .btn.ghost:hover { background:var(--accent);color:#fff }
  .palmeira .btn:focus-visible, .palmeira .opt:focus-visible, .palmeira .gcard:focus-visible, .palmeira .link:focus-visible { outline:2px solid var(--accent);outline-offset:3px }
  .palmeira .row { display:flex;flex-wrap:wrap;gap:12px;align-items:center }
  .palmeira .link { font:inherit;font-weight:600;font-size:14px;color:var(--accent);background:none;border:0;padding:6px 2px;cursor:pointer;text-decoration:underline;text-underline-offset:3px;text-shadow:0 0 8px rgba(251,243,220,.95) }
  .palmeira .hero { display:grid;gap:26px;align-items:center }
  .palmeira .hero .art { width:min(440px,96%);justify-self:center;display:flex;align-items:flex-end;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:18px 12px 10px }
  .palmeira .hero .art>span { flex:1 1 0;min-width:0 }
  .palmeira .hero .art svg { width:100%;height:auto;display:block;filter:drop-shadow(0 0 1.5px rgba(0,36,48,.5)) }
  .palmeira .meta { display:flex;gap:18px;flex-wrap:wrap;font-size:13px;color:var(--muted);font-weight:500;text-shadow:0 0 8px rgba(251,243,220,.95) }
  @media(min-width:760px) {
    .palmeira .hero { grid-template-columns:minmax(0,1fr) minmax(0,1fr) }
    .palmeira .hero .art { width:100%;max-width:480px }
  }
  .palmeira .progress { display:grid;grid-template-columns:repeat(10,1fr);gap:5px }
  .palmeira .progress i { height:5px;border-radius:3px;background:rgba(255,255,255,.55);border:1px solid var(--line) }
  .palmeira .progress i.on { background:var(--accent);border-color:var(--accent) }
  .palmeira .step { font-weight:600;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted) }
  .palmeira .opts { display:grid;grid-template-columns:minmax(0,1fr);gap:12px;margin:0;padding:0;list-style:none }
  .palmeira .opt { width:100%;font:inherit;text-align:left;color:var(--fg);background:var(--surface);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:12px;padding:15px 18px;cursor:pointer;display:flex;gap:14px;align-items:baseline;font-weight:500;transition:transform .15s,border-color .15s,background .15s }
  .palmeira .opt .n { font-family:var(--display);font-style:italic;font-size:20px;color:var(--accent);flex:none;width:16px }
  .palmeira .opt:hover { transform:translateY(-2px);border-color:var(--accent);background:rgba(255,255,255,.86) }
  .palmeira .opt:active { background:var(--accent);color:#fff }
  .palmeira .opt:active .n { color:#fff }
  .palmeira .opt.tie { flex-direction:column;gap:2px }
  .palmeira .opt.tie .nm { font-family:var(--display);font-style:italic;font-size:22px }
  .palmeira .res-hero { display:grid;gap:22px;align-items:center;background:var(--surface);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid var(--c);border-radius:10px;padding:24px }
  .palmeira .res-hero .art { width:min(220px,60%);justify-self:center }
  .palmeira .res-hero .art svg { width:100%;height:auto;display:block }
  .palmeira .res-hero .who { display:flex;flex-direction:column;gap:8px }
  .palmeira .res-hero .tag { font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--c) }
  .palmeira .res-hero .nome { font-size:clamp(34px,6.5vw,56px) }
  .palmeira .res-hero .sci { font-style:italic;color:var(--muted);font-size:14px;margin:0 }
  .palmeira .res-hero .fact-in { margin:10px 0 0;padding-top:12px;border-top:1px dashed var(--line);font-size:14.5px;color:var(--muted);font-weight:500;max-width:60ch }
  .palmeira .res-hero .fact-in b { display:block;color:var(--fg);font-weight:600;letter-spacing:.1em;text-transform:uppercase;font-size:11px;margin-bottom:3px }
  .palmeira .res-hero .tl { font-family:var(--display);font-style:italic;font-size:clamp(20px,3.4vw,26px);margin:4px 0 0;line-height:1.2 }
  @media(min-width:760px) {
    .palmeira .res-hero { grid-template-columns:220px minmax(0,1fr);padding:28px 34px }
    .palmeira .res-hero .art { width:100% }
  }
  .palmeira .topics { display:grid;gap:14px;grid-template-columns:minmax(0,1fr) }
  @media(min-width:760px) {
    .palmeira .topics { grid-template-columns:repeat(2,minmax(0,1fr)) }
  }
  .palmeira .topic { background:var(--surface);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid var(--line);border-top:3px solid var(--c);border-radius:8px;padding:18px 20px;display:flex;flex-direction:column;gap:6px }
  .palmeira .topic h3 { font-size:22px }
  .palmeira .topic p { margin:0;color:var(--muted);font-weight:500;line-height:1.55 }
  .palmeira .fact { background:var(--surface-2);border:1px dashed var(--line);border-radius:8px;padding:16px 20px;font-size:14.5px;color:var(--muted);font-weight:500 }
  .palmeira .fact b { color:var(--fg);font-weight:600;letter-spacing:.1em;text-transform:uppercase;font-size:11px;display:block;margin-bottom:4px }
  .palmeira .also { display:flex;flex-wrap:wrap;gap:10px }
  .palmeira .chip { display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:6px 16px 6px 8px;font:inherit;color:var(--fg);cursor:pointer }
  .palmeira .chip:hover { border-color:var(--accent) }
  .palmeira .chip svg { width:34px;height:34px;flex:none }
  .palmeira .chip .nm { font-family:var(--display);font-style:italic;font-size:18px }
  .palmeira .bars { display:grid;gap:8px;margin:0;padding:0;list-style:none;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:16px 18px }
  .palmeira .bars li { display:grid;grid-template-columns:minmax(0,150px) minmax(0,1fr) 40px;gap:10px;align-items:center;font-size:14px }
  .palmeira .bars .nm { font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis }
  .palmeira .bars .track { height:10px;border-radius:5px;background:rgba(6,70,64,.12);overflow:hidden }
  .palmeira .bars .fill { display:block;height:100%;border-radius:5px;background:var(--c) }
  .palmeira .bars .pc { text-align:right;color:var(--muted);font-variant-numeric:tabular-nums }
  .palmeira .sec-title { font-family:var(--display);font-style:italic;font-size:24px;margin:6px 0 -6px;text-shadow:0 0 10px rgba(251,243,220,.95) }
  .palmeira .toast { align-self:flex-start;font-size:14px;font-weight:600;color:var(--accent);background:rgba(255,255,255,.8);border-radius:999px;padding:6px 14px }
  .palmeira .gallery { display:grid;gap:14px;grid-template-columns:minmax(0,1fr) }
  @media(min-width:560px) {
    .palmeira .gallery { grid-template-columns:repeat(2,minmax(0,1fr)) }
  }
  @media(min-width:860px) {
    .palmeira .gallery { grid-template-columns:repeat(3,minmax(0,1fr)) }
  }
  .palmeira .gcard { font:inherit;text-align:left;color:var(--fg);background:var(--surface);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border:1px solid var(--line);border-bottom:3px solid var(--c);border-radius:10px;padding:14px;cursor:pointer;display:flex;gap:12px;align-items:center;transition:transform .15s }
  .palmeira .gcard:hover { transform:translateY(-2px) }
  .palmeira .gcard svg { width:64px;height:80px;flex:none }
  .palmeira .gcard .nm { font-family:var(--display);font-style:italic;font-size:21px;line-height:1.1;display:block }
  .palmeira .gcard .ds { font-size:13px;color:var(--muted);display:block;margin-top:2px }
  .palmeira .ph { position:relative;display:block;width:100% }
  .palmeira .ph img { display:block;width:100%;height:100%;object-fit:cover;border-radius:8px;border:1px solid var(--line);background:rgba(255,255,255,.4) }
  .palmeira .ph .fb { display:none }
  .palmeira .ph.bad img { display:none }
  .palmeira .ph.bad .fb { display:block }
  .palmeira .ph.bad ~ .credit { display:none }
  .palmeira .res-hero .art.has-photo .ph { aspect-ratio:4/5 }
  .palmeira .credit { font-size:11.5px;color:var(--muted);margin:6px 0 0;line-height:1.3 }
  .palmeira .credit a { color:inherit }
  .palmeira .gcard .ph { width:64px;height:80px;flex:none }
  .palmeira .gcard .ph .fb svg { width:64px;height:80px }
  .palmeira .foot { font-weight:500;font-size:12.5px;color:var(--muted);max-width:70ch }
  @media(prefers-reduced-motion:reduce) {
    .palmeira .screen { animation:none }
    .palmeira .opt, .palmeira .btn, .palmeira .gcard { transition:none }
  }
  @media(max-width:520px) {
    .palmeira .bars li { grid-template-columns:minmax(0,110px) minmax(0,1fr) 36px;font-size:13px }
  }
</style>
