---
/**
 * Simulador de Escritório: a sala em 3D (three.js). Sem React — a cena é
 * imperativa do começo ao fim, então fica num <script> que o Astro empacota
 * só pra esta página. As fontes vêm do próprio site (fontsource), nada de CDN.
 */
import '@fontsource/archivo/600.css'
import '@fontsource/archivo/700.css'
import '@fontsource/permanent-marker'
---

<div class="escritorio" id="escritorio">
  <div class="cenaWrap" id="palco">
    <div class="cams">
      <button type="button" id="pedir-cafe" class="btn-cafe">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"></path><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17"></path><path d="M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3"></path></svg>
        <span id="cafe-rot">Pedir café</span>
      </button>
      <button type="button" id="discoteca" class="btn-disco" aria-pressed="false">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2v4"></path><circle cx="12" cy="14" r="8"></circle><path d="M4 14h16M12 6c-3 3-3 13 0 16M12 6c3 3 3 13 0 16M5.5 9.5h13M5.5 18.5h13"></path></svg>
        <span id="disco-rot">Discoteca</span>
      </button>
      <button type="button" id="cam-orbita">Reenquadrar</button>
      <button type="button" id="cam-topo">Ver de cima</button>
    </div>
    <div class="hud" id="hud">arraste para girar · scroll para aproximar</div>
  </div>
  <p class="dica">clique em alguém na cena — ou use a trilha e as setas ← → para a câmera voar até a mesa</p>

  <nav class="navmesas" aria-label="Navegar pelas mesas">
    <button class="seta" id="ant" type="button">←<span id="ant-nome"></span></button>
    <div class="trilha" id="trilha" aria-label="Lugares"></div>
    <button class="seta" id="prox" type="button"><span id="prox-nome"></span>→</button>
  </nav>

  <div class="legenda" id="legenda"></div>
</div>

<script>
  import { iniciar } from './cena.js'

  const raiz = document.getElementById('escritorio')
  if (raiz) iniciar(raiz)
</script>

<!-- global porque a trilha, a legenda e o canvas são criados pelo script;
     tudo fica preso em .escritorio. -->
<style is:global>
  .escritorio {
    --linha-2: color-mix(in srgb, var(--borda), var(--texto) 18%);
    --sig-call: #e0ad52;
    --sig-fora: #8a8d86;
    margin-block: 1.5rem;
  }

  [data-tema='claro'] .escritorio {
    --sig-call: #8a5a12;
    --sig-fora: #6b6d66;
  }

  .escritorio .cenaWrap {
    position: relative;
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    overflow: hidden;
    background: var(--superficie);
    height: clamp(360px, 58vh, 640px);
    touch-action: none;
    cursor: grab;
  }

  .escritorio .cenaWrap.arrastando {
    cursor: grabbing;
  }

  .escritorio .cenaWrap canvas {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .escritorio .cams {
    position: absolute;
    inset: 12px 12px auto;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
    pointer-events: none;
  }

  .escritorio .cams button {
    pointer-events: auto;
    border: 1px solid var(--linha-2);
    background: color-mix(in srgb, var(--superficie) 88%, transparent);
    color: var(--texto);
    border-radius: 4px;
    padding: 6px 11px;
    font: inherit;
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }

  .escritorio .cams button:hover {
    border-color: var(--destaque);
    color: var(--destaque);
  }

  .escritorio .cams .btn-cafe {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--destaque);
    border-color: var(--destaque);
    color: var(--fundo);
    font-weight: 600;
  }

  .escritorio .cams .btn-cafe:hover {
    color: var(--fundo);
    filter: brightness(1.08);
  }

  .escritorio .cams .btn-cafe:disabled {
    cursor: progress;
    opacity: 0.8;
    filter: none;
  }

  .escritorio .cams .btn-disco {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .escritorio .cams .btn-disco[aria-pressed='true'] {
    color: #fff;
    border-color: transparent;
    background: linear-gradient(90deg, #ff2e88, #b04bff, #2ec4ff, #7cff4f, #ffd23f, #ff2e88);
    background-size: 300% 100%;
    animation: escritorio-arcoiris 2.4s linear infinite;
  }

  @keyframes escritorio-arcoiris {
    to {
      background-position: 300% 0;
    }
  }

  .escritorio .hud {
    position: absolute;
    left: 12px;
    top: 12px;
    pointer-events: none;
    background: color-mix(in srgb, var(--superficie) 88%, transparent);
    border: 1px solid var(--linha-2);
    border-radius: 100px;
    padding: 5px 12px;
    font-family: var(--fonte-mono);
    font-size: 0.7rem;
    color: var(--texto-suave);
    backdrop-filter: blur(6px);
    transition: opacity 0.5s ease;
  }

  .escritorio .semwebgl {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    color: var(--texto-suave);
  }

  .escritorio .dica {
    margin: 10px 2px 0;
    font-family: var(--fonte-mono);
    font-size: 0.78rem;
    color: var(--texto-suave);
  }

  .escritorio .navmesas {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .escritorio .seta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border-radius: 4px;
    border: 1px solid var(--linha-2);
    background: var(--superficie);
    color: var(--texto);
    font: inherit;
    font-size: 0.82rem;
    line-height: 1;
    cursor: pointer;
  }

  .escritorio .seta:hover {
    border-color: var(--destaque);
    color: var(--destaque);
  }

  .escritorio .trilha {
    display: flex;
    gap: 4px;
    flex: 1 1 320px;
    min-width: 0;
    overflow-x: auto;
    padding: 3px 2px;
    align-items: center;
  }

  .escritorio .trilha button {
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    padding: 0;
    border-radius: 4px;
    border: 1px solid var(--borda);
    background: var(--superficie);
    color: var(--texto-suave);
    font-family: var(--fonte-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    cursor: pointer;
  }

  .escritorio .trilha button:hover {
    border-color: var(--linha-2);
    color: var(--texto);
  }

  .escritorio .trilha button[aria-current='true'] {
    background: var(--destaque);
    border-color: var(--destaque);
    color: var(--fundo);
    font-weight: 600;
  }

  .escritorio .trilha button.fora {
    border-style: dashed;
  }

  .escritorio .trilha .sep {
    flex: 0 0 auto;
    padding: 0 6px;
    font-family: var(--fonte-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--texto-suave);
    white-space: nowrap;
  }

  .escritorio .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .escritorio .chip {
    --c: var(--destaque);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 11px 4px 9px;
    border-radius: 100px;
    font-family: var(--fonte-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    background: color-mix(in srgb, var(--c) 15%, transparent);
    color: var(--c);
  }

  .escritorio .chip i {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .escritorio .chip.call {
    --c: var(--sig-call);
  }

  .escritorio .chip.fora {
    --c: var(--sig-fora);
  }

  @media (max-width: 560px) {
    .escritorio .hud {
      display: none;
    }

    .escritorio .cams button {
      padding: 6px 9px;
      font-size: 0.75rem;
    }
  }
</style>
