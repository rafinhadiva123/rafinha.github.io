---
/**
 * Simulador de Escritório: a sala em 3D (three.js), com cadeiras vazias que
 * qualquer visitante ocupa montando um personagem. Sem React — a cena é
 * imperativa do começo ao fim, então fica num <script> que o Astro empacota
 * só pra esta página. As fontes vêm do próprio site (fontsource), nada de CDN.
 */
import '@fontsource/archivo/600.css'
import '@fontsource/archivo/700.css'
---

<div class="escritorio" id="escritorio">
  <div class="cenaWrap" id="palco">
    <div class="cams">
      <button type="button" id="pedir-cafe" class="btn-cafe">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"></path><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17"></path><path d="M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3"></path></svg>
        <span id="cafe-rot">Pedir café</span>
      </button>
      <button type="button" id="discoteca" class="btn-disco" aria-pressed="false">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2v4"></path><circle cx="12" cy="14" r="8"></circle><path d="M4 14h16M12 6c-3 3-3 13 0 16M12 6c3 3 3 13 0 16M5.5 9.5h13M5.5 18.5h13"></path></svg>
        <span id="disco-rot">Discoteca</span>
      </button>
      <button type="button" id="cam-orbita">Reenquadrar</button>
      <button type="button" id="cam-topo">Ver de cima</button>
    </div>
    <div class="hud" id="hud">clique num <b>+</b> para sentar · arraste para girar · scroll para aproximar</div>
    <p class="aviso" id="aviso" role="status" hidden></p>
    <div class="editor" id="editor" hidden></div>
  </div>

  <nav class="navmesas" aria-label="Navegar pelas cadeiras">
    <button class="seta" id="ant" type="button" aria-label="Cadeira anterior">←<span id="ant-nome"></span></button>
    <p class="lotacao">
      <span id="lotacao">Carregando o escritório…</span>
      <span class="modo-teste" id="modo-teste" hidden title="O Supabase ainda não foi configurado: os personagens ficam só neste navegador.">modo de teste</span>
    </p>
    <button class="seta" id="prox" type="button" aria-label="Próxima cadeira"><span id="prox-nome"></span>→</button>
  </nav>
</div>

<script>
  import { iniciar } from './cena.js'

  const raiz = document.getElementById('escritorio')
  if (raiz) iniciar(raiz)
</script>

<!-- global porque o canvas é criado pelo script;
     tudo fica preso em .escritorio. -->
<style is:global>
  .escritorio {
    --linha-2: color-mix(in srgb, var(--borda), var(--texto) 18%);
    margin-block: 1.5rem;
  }

  .escritorio .cenaWrap {
    position: relative;
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    overflow: hidden;
    background: var(--superficie);
    height: clamp(360px, 58vh, 640px);
    touch-action: none;
    cursor: grab;
  }

  .escritorio .cenaWrap.arrastando {
    cursor: grabbing;
  }

  .escritorio .cenaWrap canvas {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .escritorio .cams {
    position: absolute;
    inset: 12px 12px auto;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
    pointer-events: none;
  }

  .escritorio .cams button {
    pointer-events: auto;
    border: 1px solid var(--linha-2);
    background: color-mix(in srgb, var(--superficie) 88%, transparent);
    color: var(--texto);
    border-radius: 4px;
    padding: 6px 11px;
    font: inherit;
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }

  .escritorio .cams button:hover {
    border-color: var(--destaque);
    color: var(--destaque);
  }

  .escritorio .cams .btn-cafe {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--destaque);
    border-color: var(--destaque);
    color: var(--fundo);
    font-weight: 600;
  }

  .escritorio .cams .btn-cafe:hover {
    color: var(--fundo);
    filter: brightness(1.08);
  }

  .escritorio .cams .btn-cafe:disabled {
    cursor: progress;
    opacity: 0.8;
    filter: none;
  }

  .escritorio .cams .btn-disco {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .escritorio .cams .btn-disco[aria-pressed='true'] {
    color: #fff;
    border-color: transparent;
    background: linear-gradient(90deg, #ff2e88, #b04bff, #2ec4ff, #7cff4f, #ffd23f, #ff2e88);
    background-size: 300% 100%;
    animation: escritorio-arcoiris 2.4s linear infinite;
  }

  @keyframes escritorio-arcoiris {
    to {
      background-position: 300% 0;
    }
  }

  .escritorio .hud {
    position: absolute;
    left: 12px;
    top: 12px;
    pointer-events: none;
    background: color-mix(in srgb, var(--superficie) 88%, transparent);
    border: 1px solid var(--linha-2);
    border-radius: 100px;
    padding: 5px 12px;
    font-family: var(--fonte-mono);
    font-size: 0.7rem;
    color: var(--texto-suave);
    backdrop-filter: blur(6px);
    transition: opacity 0.5s ease;
  }

  .escritorio .semwebgl {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    color: var(--texto-suave);
  }

  .escritorio .navmesas {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
    justify-content: space-between;
  }

  .escritorio .seta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border-radius: 4px;
    border: 1px solid var(--linha-2);
    background: var(--superficie);
    color: var(--texto);
    font: inherit;
    font-size: 0.82rem;
    line-height: 1;
    cursor: pointer;
  }

  .escritorio .seta:hover {
    border-color: var(--destaque);
    color: var(--destaque);
  }

  /* modo tela inteira (largura: 'tela'): a cena ocupa todo o espaço e as
     setas das mesas flutuam sobre ela */
  body:has(.experimento__corpo--tela) {
    overflow-x: clip;
  }

  .experimento__corpo--tela .escritorio {
    position: relative;
    height: 100%;
    margin: 0;
  }

  .experimento__corpo--tela .escritorio .cenaWrap {
    height: 100%;
    border: 0;
    border-radius: 0;
  }

  .experimento__corpo--tela .escritorio .navmesas {
    position: absolute;
    inset: auto 12px 12px;
    margin: 0;
    pointer-events: none;
  }

  .experimento__corpo--tela .escritorio .seta {
    pointer-events: auto;
    background: color-mix(in srgb, var(--superficie) 88%, transparent);
    backdrop-filter: blur(6px);
  }


  /* ---- contador de cadeiras ---- */
  .escritorio .lotacao {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--fonte-mono);
    font-size: 0.72rem;
    color: var(--texto-suave);
    padding: 6px 12px;
    border-radius: 100px;
    border: 1px solid var(--linha-2);
    background: color-mix(in srgb, var(--superficie) 88%, transparent);
    backdrop-filter: blur(6px);
    pointer-events: auto;
  }

  .escritorio .modo-teste {
    padding: 2px 7px;
    border-radius: 100px;
    background: color-mix(in srgb, var(--destaque) 18%, transparent);
    color: var(--destaque);
    font-weight: 600;
  }

  /* ---- aviso rápido (sentou, erro de rede…) ---- */
  .escritorio .aviso {
    position: absolute;
    left: 50%;
    top: 56px;
    transform: translateX(-50%);
    margin: 0;
    max-width: min(90%, 460px);
    padding: 9px 14px;
    border-radius: 6px;
    background: var(--texto);
    color: var(--fundo);
    font-size: 0.85rem;
    line-height: 1.35;
    text-align: center;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
    z-index: 3;
  }

  /* ---- painel "Monte seu personagem" ---- */
  .escritorio .editor {
    position: absolute;
    top: 56px;
    right: 12px;
    bottom: 12px;
    width: min(340px, calc(100% - 24px));
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
    cursor: auto;
    z-index: 2;
    border: 1px solid var(--linha-2);
    border-radius: var(--raio);
    background: color-mix(in srgb, var(--superficie) 94%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.22);
  }

  .escritorio .editor[hidden] {
    display: none;
  }

  .experimento__corpo--tela .escritorio .editor {
    bottom: 64px;
  }

  .escritorio:has(.editor:not([hidden])) .navmesas .seta {
    visibility: hidden;
  }

  .escritorio .ed-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 16px 14px;
  }

  .escritorio .ed-topo {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .escritorio .ed-titulo {
    margin: 0;
    font-family: Archivo, var(--fonte-texto);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .escritorio .ed-sub {
    margin: 4px 0 0;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--texto-suave);
  }

  .escritorio .ed-fechar {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--linha-2);
    background: transparent;
    color: var(--texto-suave);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }

  .escritorio .ed-fechar:hover {
    color: var(--texto);
    border-color: var(--texto-suave);
  }

  .escritorio .ed-rot {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--texto-suave);
    padding: 0;
    margin-bottom: 6px;
  }

  .escritorio .ed-campo {
    position: relative;
    margin-top: -4px;
  }

  .escritorio .ed-input {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 52px 10px 12px;
    border-radius: 6px;
    border: 1px solid var(--linha-2);
    background: var(--fundo);
    color: var(--texto);
    font: inherit;
    font-size: 1rem;
  }

  .escritorio .ed-input:focus {
    outline: 2px solid var(--destaque);
    outline-offset: 1px;
    border-color: transparent;
  }

  .escritorio .ed-cont {
    position: absolute;
    right: 11px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--fonte-mono);
    font-size: 0.7rem;
    color: var(--texto-suave);
  }

  .escritorio .ed-grupos {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .escritorio .ed-grupo {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .escritorio .ed-cores,
  .escritorio .ed-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .escritorio .ed-cor {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--superficie);
    background: var(--c);
    box-shadow: 0 0 0 1px var(--linha-2);
    cursor: pointer;
    padding: 0;
  }

  .escritorio .ed-cor[aria-pressed='true'] {
    box-shadow: 0 0 0 2px var(--destaque);
  }

  .escritorio .ed-chip {
    padding: 6px 10px;
    border-radius: 100px;
    border: 1px solid var(--linha-2);
    background: transparent;
    color: var(--texto);
    font: inherit;
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
  }

  .escritorio .ed-chip:hover {
    border-color: var(--texto-suave);
  }

  .escritorio .ed-chip[aria-pressed='true'] {
    background: var(--destaque);
    border-color: var(--destaque);
    color: var(--fundo);
    font-weight: 600;
  }

  .escritorio .ed-erro {
    margin: 0;
    min-height: 1.1em;
    font-size: 0.8rem;
    color: #e5484d;
  }

  .escritorio .ed-erro:empty {
    min-height: 0;
  }

  .escritorio .ed-acoes {
    position: sticky;
    bottom: -14px;
    display: flex;
    gap: 8px;
    margin: 0 -16px -14px;
    padding: 10px 16px 14px;
    background: color-mix(in srgb, var(--superficie) 97%, transparent);
    border-top: 1px solid var(--borda);
  }

  .escritorio .ed-sec,
  .escritorio .ed-pri {
    flex: 1;
    padding: 10px 12px;
    border-radius: 6px;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }

  .escritorio .ed-sec {
    border: 1px solid var(--linha-2);
    background: transparent;
    color: var(--texto);
  }

  .escritorio .ed-pri {
    border: 1px solid var(--destaque);
    background: var(--destaque);
    color: var(--fundo);
  }

  .escritorio .ed-pri:disabled,
  .escritorio .ed-sec:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  @media (max-width: 700px) {
    /* no celular o painel vira uma folha embaixo e o boneco aparece acima dela */
    .escritorio .editor,
    .experimento__corpo--tela .escritorio .editor {
      top: auto;
      left: 8px;
      right: 8px;
      bottom: 8px;
      width: auto;
      max-height: 56%;
    }

    .escritorio .aviso {
      top: auto;
      bottom: 64px;
    }
  }

  @media (max-width: 560px) {
    .escritorio .hud {
      display: none;
    }

    .escritorio .seta span {
      display: none;
    }

    .escritorio .navmesas {
      flex-wrap: nowrap;
    }

    .escritorio .lotacao {
      font-size: 0.66rem;
      padding: 6px 10px;
      white-space: nowrap;
    }

    .escritorio .cams button {
      padding: 6px 9px;
      font-size: 0.75rem;
    }
  }
</style>
