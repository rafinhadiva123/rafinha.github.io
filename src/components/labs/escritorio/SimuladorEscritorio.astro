---
/**
 * Simulador de escritório: o andar inteiro, com os 15 de sempre e quem
 * passou por aqui e sentou (salvo no Supabase, para todo mundo ver ao vivo).
 *
 * O HTML daqui é só a moldura. O script é pequeno: decide entre o 3D e a
 * planta sem 3D e só então baixa o código da versão escolhida (three, o
 * andar, as piadas), com import dinâmico. Ver ui/pagina.js.
 */
---

<div class="escritorio" id="escritorio" data-versao="">
  <div class="esc-palco" data-esc="palco">
    <p class="esc-carregando">Carregando o escritório…</p>
    <noscript><p class="esc-carregando">O escritório precisa de JavaScript para aparecer.</p></noscript>
  </div>
</div>

<script>
  import { iniciarPagina } from './ui/pagina.js'

  const raiz = document.getElementById('escritorio')
  if (raiz) iniciarPagina(raiz)
</script>

<style is:global>
  .escritorio {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-block: 1.5rem;
  }

  .escritorio [hidden] {
    display: none !important;
  }

  /* a altura já vale antes do CSS do escritório chegar (sem pulo na página) */
  .escritorio > .esc-palco {
    flex: none;
    position: relative;
    overflow: hidden;
    height: clamp(360px, 62vh, 680px);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    background: var(--superficie);
  }

  .escritorio .esc-carregando {
    display: grid;
    place-items: center;
    height: 100%;
    margin: 0;
    padding: 24px;
    text-align: center;
    color: var(--texto-suave);
  }

  /* modo tela inteira (largura: 'tela'): o andar ocupa a janela */
  body:has(.experimento__corpo--tela) {
    overflow-x: clip;
  }

  .experimento__corpo--tela .escritorio {
    height: 100%;
    margin: 0;
    gap: 0;
  }

  .experimento__corpo--tela .escritorio > .esc-palco {
    flex: 1;
    min-height: 0;
    height: auto;
    border: 0;
    border-radius: 0;
  }
</style>
