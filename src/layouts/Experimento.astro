---
import Base from './Base.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  experimento: CollectionEntry<'experimentos'>
}

const { experimento } = Astro.props
const { titulo, resumo, data, tags, largura } = experimento.data
const dataFormatada = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long' }).format(data)
---

<Base titulo={`${titulo} · rafinha.xyz`} descricao={resumo}>
  <article class="experimento">
    <header class:list={['experimento__cabecalho', largura === 'tela' && 'visualmente-oculto']}>
      <h1>{titulo}</h1>
      {
        largura !== 'tela' && (
          <div class="experimento__meta">
            <time datetime={data.toISOString()}>{dataFormatada}</time>
            {tags.length > 0 && (
              <ul class="experimento__tags">
                {tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </header>
    <div
      class:list={[
        'experimento__corpo',
        largura === 'leitura' ? 'leitura' : 'experimento__corpo--larga',
        largura === 'tela' && 'experimento__corpo--tela',
      ]}
    >
      <slot />
    </div>
  </article>
</Base>

<style>
  .experimento__cabecalho h1 {
    margin-bottom: 0.5rem;
  }

  .experimento__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    color: var(--texto-suave);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .experimento__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .experimento__tags li {
    border: 1px solid var(--borda);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }

  /* sai do .pagina e ocupa a janela toda abaixo do cabeçalho do site
     (padding 1rem×2 + linha 1.6rem + borda 1px) */
  .experimento__corpo--tela {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    height: calc(100dvh - 3.6rem - 1px);
  }

  .visualmente-oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .experimento__corpo--larga > :global(:is(p, ul, ol, h2, h3, blockquote)) {
    max-width: var(--largura-leitura);
  }
</style>
